<%# locals: () -%>
<%= form_with url: '/search', method: :get, html: { aria: {label: "Buscar"} }, class: "search-form" do |f| %>
  <div class="boxline">
    <%= f.text_field "q", { aria: { label: "Texto de búsqueda" }, value: @search.q, size: 40, autocapitalize: :off, type: "search" }.
      merge(@search.q.present? ? {} : { :autofocus => "autofocus" }) %>
    <input type="submit" value="Buscar">
  </div>

  <fieldset class="radio-group-container">
    <legend>Buscar</legend>
    <div class="radio-group">
      <label><%= f.radio_button "what", "stories", checked: @search.what == :stories %> Historias</label>
      <label><%= f.radio_button "what", "comments", checked: @search.what == :comments %> Comentarios</label>
    </div>
  </fieldset>

  <fieldset class="radio-group-container">
    <legend>Ordenar por</legend>
    <div class="radio-group">
      <label><%= f.radio_button "order", "newest", checked: @search.order == :newest %> Más recientes</label>
      <label><%= f.radio_button "order", "relevance", checked: @search.order == :relevance %> Relevancia</label>
      <label><%= f.radio_button "order", "score", checked: @search.order == :score %> Puntuación</label>
    </div>
  </fieldset>
<% end %>

<% if @search.results_count > -1 %>
  <div class="box searchresults">
    <details <%= "open" if @search.results_count == 0 %>>
      <summary>
        <span class="heading"><%= @search.results_count %> resultado<%= @search.results_count == 1 ? "" : "s" %> para </span>
        <span class="searchq"><%= @search.q %></span>
      </summary>

      <% if @search.invalid_because %>
        <div class="flash-error"><%= @search.invalid_because %></div>
      <% end %>

      <p>
      La búsqueda se ha interpretado como:
      </p>
      <dl class="search_parse">
        <%
          @search.parse_tree.each do |node|
            type, value = node.first

            case type
          when :commenter %>
          <dt><span class="searchq">commenter:<%= value %></span></dt>
          <dd>Comentario de: <%= link_to value, user_path(value) %></dd>
        <% when :domain %>
          <dt><span class="searchq">domain:<%= value %></span></dt>
          <dd>Dominio: <%= link_to value, domain_path(value) %></dd>
        <% when :submitter %>
          <dt><span class="searchq">submitter:<%= value %></span></dt>
          <dd>Historia enviada por: <%= link_to value, user_path(value) %></dd>
        <% when :tag %>
          <dt><span class="searchq">tag:<%= value %></span></dt>
          <dd>Etiqueta: <%= link_to value, tag_path(value) %></dd>
        <% when :title %>
          <dt><span class="searchq">title:<%= @search.flatten_title(value) %></span></dt>
          <dd>Título: <%= @search.flatten_title(value) %></dd>
        <% when :url %>
          <dt><span class="searchq">url:<%= value %></span></dt>
          <dd>URL: <%= value %></dd>
        <% when :user %>
          <dt><span class="searchq">@<%= value %></span></dt>
          <dd><%= @search.searched_model.name %> de: <%= link_to value, user_path(value) %></dd>
        <% when :negated %>
        <% when :quoted %>
          <dt><span class="searchq">"<%= value.pluck(:term).join(" ") %>"</span></dt>
          <dd>
            Cita: <span class="searchq">"<%= @search.strip_operators(value.pluck(:term).join(" ")) %>"</span>
            <% if !value.to_s.include?(' ') %>
              <br>Entrecomillar una sola palabra es redundante; los términos son exactos.
            <% end %>
            <% if value.pluck(:term).join(" ").to_s != @search.strip_operators(value.pluck(:term).join(" ")) %>
              <br>Se han eliminado signos de puntuación que podrían haberse interpretado como un <a href="https://mariadb.com/kb/ru/full-text-index-overview/#in-boolean-mode">operador de búsqueda SQL</a>.
            <% end %>
          </dd>
        <% when :term %>
          <dt><span class="searchq"><%= value %></span></dt>
          <dd>
            Término: <span class="searchq"><%= @search.strip_short_terms(@search.strip_operators(value)) %></span>
            <% if value.to_s != @search.strip_operators(value) %>
              <br>Se han eliminado signos de puntuación que podrían haberse interpretado como un <a href="https://mariadb.com/kb/ru/full-text-index-overview/#in-boolean-mode">operador de búsqueda SQL</a>.
            <% end %>
            <% if value.to_s != @search.strip_short_terms(value) %>
              <br>Los términos deben tener al menos 4 caracteres.
            <% end %>
          </dd>
        <% when :shortword %>
          <dt><span class="searchq"><%= value %></span></dt>
          <dd>
            Palabra corta: <span class="searchq"><%= value %></span>
              <br>Los términos deben tener al menos 3 caracteres.
              Si buscas una frase, usa comillas, como <span class="searchq">"Files are hard"</span>.
            <% if value.to_s != @search.strip_short_terms(value) %>
              <% if value.to_s.downcase =~ /\b(d\b|go\b|ml\b|c([+][+]|\b)?)/ %>
                <% lang = $& %>
                <br>Para el
                <% if value.to_s.downcase =~ /\bgo\b/ %>
                  malísimamente bautizado
                <% end %>
                lenguaje, usa <span class="searchq">tag:<%= lang %></span>
              <% end %>
              <% if value.to_s.downcase =~ /\b(ai|ml)\b/ %>
                <br>Usa <span class="searchq">tag:ai</span> para inteligencia artificial/aprendizaje automático
              <% end %>
            <% end %>
          </dd>
        <% when :stopword %>
          <dt><span class="searchq"><%= value %></span></dt>
          <dd>
            Palabra vacía: <span class="searchq"><%= value %></span>
            <br>El motor de búsqueda ha excluido una <a href="https://mariadb.com/kb/en/full-text-index-stopwords/#innodb-stopwords">palabra muy común</a>
            Si buscas una frase, usa comillas, como <span class="searchq">"zombo com"</span>.
            (Limitación curiosa: MariaDB sigue ignorando las palabras vacías cuando son la primera palabra de una cita.)
          </dd>
        <% when :catchall %>
          <dt><span class="searchq"><%= value %></span></dt>
          <dd>
            Comodín: <span class="searchq"><%= @search.strip_operators(value) %></span>
            Si intentabas usar un operador de búsqueda, no se ha reconocido.
          </dd>
        <% else %>
          <dt>vaya</dt>
          <dd>El desarrollador olvidó gestionar un caso de búsqueda. Por favor, informa del error con tus términos de búsqueda.</dd>
        <% end %>
      <% end %>
      </dl>
    </details>
  </div>

  <% if @search.what == :stories %>
    <ol class="stories list">
      <% @results.each do |story| %>
<%#heinous_inline_partial(stories/_listdetail.html.erb)%>
<%# Do not edit, the content before /heinous_inline_partial comes from the named partial %>
<%# locals: (story:) -%>

<%# remember: _singledetail replicates a lot of this for the single-story view %>

<%#
  The h-entry, u-report-of, u-url and h-card css classes are necessary
  for the webmentions support. http://microformats.org/wiki/h-entry

  This has apparently useless <span> tags explained in a comment in CSS
  around .negative_1 in CSS (introduced same commit as this comment).
%>
<li id="story_<%= story.short_id %>" data-shortid="<%= story.short_id %>"
class="story <%= story.current_upvoted? ? "upvoted" : "" %>
<%= story.current_flagged? ? "flagged" : "" %>
<%= story.negativity_class %>
<%= story.is_hidden_by_cur_user ? "hidden" : "" %>
<%= story.is_saved_by_cur_user ? "saved" : "" %>
<%= story.is_deleted? ? "deleted" : "" %>">
<div class="story_liner h-entry">
  <div class="voters">
    <%= link_to (story.show_score_to_user?(@user) ? story.score : '~'),
                (@user ? '': login_path), :class => "upvoter" %>
  </div>
  <div class="details">
    <span role="heading" aria-level="1" class="link h-cite u-repost-of">
      <% if story.can_be_seen_by_user?(@user) %>
        <a class="u-url" href="<%= Routes.url_or_comments_path(story) %>" rel="ugc <%= story.send_referrer? ? '' : 'noreferrer' %>"><%= story.title %></a>
      <% end %>
      <% if story.is_gone? %>
        [Historia eliminada por <%= story.is_moderated? ? "un moderador" : "el autor" %>]
      <% end %>
    </span>
    <% if story.stories_count > 0 %>
      <span class="merge" aria-label="<%= story.stories_count + 1 %> historias fusionadas"><%= story.stories_count + 1 %></span>
    <% elsif story.merged_story_id %>
      <span class="merge">fusionada</span>
    <% end %>
    <% if story.markeddown_description.present? %>
      <a
        aria-label="<%= "Texto de descripción de: #{story.title}" %>"
        class="description_present"
        title="<%= truncate(story.description, :length => 500) %>"
        href="<%= Routes.title_path story %>">&#x2636;</a>
    <% end %>
    <% if story.can_be_seen_by_user?(@user) %>
      <span class="tags">
        <% story.tags.each do |tag| %>
          <%= tag_link(tag) %>
        <% end %>
      </span>
      <% if story.origin.present? %>
        <%= link_to story.origin.identifier, origin_path(story.origin), class: 'domain' %>
      <% elsif story.domain.present? %>
        <%= link_to story.domain.domain, domain_path(story.domain), class: 'domain' %>
      <% end %>
    <% end %>

    <% if story.can_be_seen_by_user?(@user) && @user&.show_story_previews? %>
      <% if (sc = story.description_or_story_text()).present? %>
        <details class="story_content">
          <summary><%= sc %></summary>
        </details>
      <% end %>
    <% end %>

    <div class="byline">
      <%= inline_avatar_for @user, story.user %>
      <% if story.previewing %>
        <% if story.user_is_author? %>
          <span> escrito por </span>
        <% else %>
          <span> vía </span>
        <% end %>

        <%= styled_user_link story.user, story, class: ['u-author', 'h-card'] %> <%= you_invited you: @user, user: story.user %>
        <span> justo ahora </span>
      <% else %>
        <% if story.user_is_author? %>
          <span> escrito por </span>
        <% else %>
          <span> vía </span>
        <% end %>
        <%= styled_user_link story.user, story, class: ['u-author', 'h-card'] %> <%= you_invited you: @user, user: story.user %>

        <%= how_long_ago_label(story.created_at) %>

        <% if story.is_editable_by_user?(@user) %>
          <%= divider_tag %>
          <a href="<%= edit_story_path(story.short_id) %>" class="<%= story.has_suggestions? ? "story_has_suggestions" : "" %>">editar</a>
        <% end %>
        <% if @user&.is_moderator? %>
          <%= divider_tag %>
          <a href="<%= edit_mod_story_path(story.short_id) %>" class="<%= story.has_suggestions? ? "story_has_suggestions" : "" %>">edición mod</a>
        <% end %>
        <% if story.can_have_suggestions_from_user?(@user) %>
          <%= divider_tag %><%= link_to "sugerir", new_story_suggestion_path(story.short_id),
            :class => "suggester" %>
        <% end %>
        <% if !story.is_gone? && @user %>
          <% if @user && story.current_flagged? %>
            <%= divider_tag %><a class="flagger">quitar marca (<%=
              Vote::STORY_REASONS[story.current_vote[:reason]].to_s.downcase %>)</a>
          <% elsif @user && @user.can_flag?(story) %>
            <%= divider_tag %>
            <span class="dropdown_parent">
              <a class="flagger">marcar</a>
            </span>
          <% end %>
          <%= divider_tag %>
          <%= form_with :class => "hider", url: story.is_hidden_by_cur_user ? story_unhide_path(story.short_id) : story_hide_path(story.short_id) do |form| %>
            <%= form.submit story.is_hidden_by_cur_user ? "mostrar" : "ocultar", :class => "btn-link" %>
          <% end %>
          <%= divider_tag %>
          <%= form_with :class => "saver", url: story.is_saved_by_cur_user ? story_unsave_path(story.short_id) : story_save_path(story.short_id) do |form| %>
            <%= form.submit story.is_saved_by_cur_user ? "quitar de guardados" : "guardar", :class => "btn-link" %>
          <% end %>

        <% end %>
        <% if story.url.present? && (!story.is_gone? || @user.try(:is_moderator?))  %>
          <%= divider_tag %>
          <details class="caches" name="caches">
            <summary>cachés</summary>
            <ul>
              <li><a href="<%= story.archiveorg_url %>">Archive.org</a></li>
              <li><a href="<%= story.ghost_url %>">Ghostarchive</a></li>
            </ul>
          </details>
        <% end %>
        <% if !story.is_gone? || @user.try(:is_moderator?) %>
          <span class="comments_label">
            <%= divider_tag %>
            <a role="heading" aria-level="2" href="<%= Routes.title_path story %>">
            <% if story.comments_count == 0 %>
              sin comentarios
            <% else %>
              <%= story.comments_count %> <%= story.comments_count == 1 ? 'comentario' : 'comentarios' %>
            <% end %>
            </a>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
<a href="<%= Routes.title_path story %>" class="mobile_comments <%= story.comments_count == 0 ? "zero" : "" %>" style="display: none;">
  <span><%= story.comments_count %></span>
</a>
</li>

<%#/heinous_inline_partial(stories/_listdetail.html.erb)%>
      <% end %>
    </ol>
  <% elsif @search.what == :comments %>
    <ol class="comments comments1">
      <% @results.each do |res| %>
        <li><%= render "comments/comment", :comment => res, :show_story => true %>
          <ol class="comments"></ol>
        </li>
    <% end %>
    </ol>
  <% end %>

  <% if @search.results_count > @search.per_page %>
    <div class="page_link_buttons">
      Página:

      <% page_numbers_for_pagination(@search.page_count, @search.page).each do |p| %>
        <% if p.is_a?(Integer) %>
          <%= link_to p, search_path(@search.to_param.merge(page: p)), class: (@search.page == p ? 'cur' : '') %>
        <% else %>
          <span>...</span>
        <% end %>
      <% end %>
    </div>
  <% elsif @search.results_count == 1 %>
    <div class="page_link_buttons">
      <p>Hapax legomenon</p>
    </div>
  <% end %>
<% else %>
  <div class="help">
    <label>Consejos de búsqueda:</label>
    <ul>
      <li>Los términos de búsqueda son obligatorios. Usa comillas si quieres <span class="searchq">"palabras juntas"</span></li>
      <li>Los términos son exactos, así que <span class="searchq">code</span> no coincide con <span class="searchq">coder</span> ni con <span class="searchq">coding</span>. Puedes aproximar la raíz con <span class="searchq">cod*</span></li>
      <li>Busca por título con <span class="searchq">title:kernel</span> o <span class="searchq">title:"linux kernel"</span></li>
      <li>Busca por dominio con <span class="searchq">domain:example.com</span></li>
      <li>Busca por autor de la historia con <span class="searchq">submitter:alice</span> o por autor de un comentario con <span class="searchq">commenter:bob</span></li>
      <li>Busca por <%= link_to 'etiqueta', tags_path %> con <span class="searchq">tag:meta</span></li>
    </ul>
  </div>
<% end %>
