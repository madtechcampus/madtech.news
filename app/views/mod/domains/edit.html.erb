<div id="domain_box" class="box wide">
  <h1><%= "Nuevo dominio" if @domain.new_record? %> <%= @domain.domain %></h1>

  <%= form_with model: [:mod, @domain] do |f| %>
    <%= errors_for @domain %>

    <%= hidden_field_tag :new_domain, @domain.domain || params[:id] %>
    <div class="boxline">
      <%= f.label :selector, "Selector de origen" %>
      <%= f.text_field :selector, autocapitalize: :off %>
      <div class="d"><p class="help">Expresión regular con capturas; debe consumir toda la cadena, por ejemplo: <kbd>\Ahttps?://github.com/+([^/]+).*\z</kbd></p></div>
    </div>

    <div class="boxline">
      <%= f.label :replacement, "Reemplazo de origen" %>
      <%= f.text_field :replacement, autocapitalize: :off %>
      <div class="d"><p class="help"><kbd>github.com/\1</kbd></p></div>
    </div>

    <div class="boxline">
      <%= f.submit 'Guardar' %>
    </div>
  <% end %>

  <br><br><hr><br>

  <% if @domain.banned_at %>
    <label>Estado</label>
    <span class="d">
      Baneado
    </span>
    <br>

    <label>Motivo del baneo</label>
    <span class="d">
      <%= @domain.banned_reason %>
    </span>
    <br>

    <label>Baneado el</label>
    <span class="d">
      <%= @domain.banned_at %>
    </span>
    <br>

    <label>Baneado por el usuario</label>
    <span class="d">
      <%= @domain.banned_by_user.username %>
    </span>
  <% end %>

  <%= form_with model: @domain, url: @domain.new_record? ? mod_create_and_ban_domain_path(id: @domain.domain) : mod_ban_domain_path(id: @domain.domain) do |f| %>
    <%= hidden_field_tag :new_domain, @domain.new_record? %>

    <div class="boxline">
      <%= f.label :banned_reason, "Motivo de #{caption_of_button(@domain)}" %>
      <%= f.text_field :banned_reason, required: true, value: '' %>
    </div>

    <div class="boxline">
        <%= f.submit caption_of_button(@domain), class: 'deletion' %>
    </div>
  <% end %>
</div>
