<%# locals: (tag:) -%>
<%= form_with model: [:mod, tag] do |f| %>
  <div class="labelled_grid">
    <%= f.label :tag, 'Nombre' %>
    <%= f.text_field :tag, required: true, autocapitalize: :off, pattern: Tag::TAG_FORMAT.source.gsub(/\\A|\\z/,
 "").sub("-]", "\\-]"), maxlength: Tag::NAME_MAXLENGTH  %>

    <%= f.label :category_name, 'Categoría' %>
    <%= f.select :category_name, options_for_select(Category.pluck(:category), tag.category_name) %>

    <%= f.label :description, 'Descripción' %>
    <%= f.text_field :description, maxlength: Tag::DESCRIPTION_MAXLENGTH %>

    <%= f.label :permit_by_new_users, 'Permitir a usuarios nuevos', :class => "for_checkbox" %>
    <%= f.check_box :permit_by_new_users %>

    <%= f.label :privileged, 'Privilegiada', :class => "for_checkbox" %>
    <%= f.check_box :privileged %>

    <%= f.label :is_media, 'Es multimedia', :class => "for_checkbox" %>
    <%= f.check_box :is_media %>

    <%= f.label :active, 'Activa', :class => "for_checkbox" %>
    <%= f.check_box :active %>

    <%= f.label :hotness_mod, 'Ajuste de relevancia' %>
    <%= f.number_field :hotness_mod, step: 0.01 %>
  </div>
  <%= f.submit tag.persisted? ? 'Actualizar etiqueta' : 'Crear etiqueta' %>
<% end %>
