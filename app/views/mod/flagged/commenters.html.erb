<%= render partial: 'mod/subnav', locals: { periods: @periods } %>

<% if @commenters.present? %>
  <table class='data zebra' style='margin: 0 auto;'>
    <tr>
      <th>Usuario</th>
      <th title="Número de desviaciones estándar por encima del comentarista medio">+&sigma;</th>
      <th class="r" title="Reportes por comentario">D/C</th>
      <th class="r" title="nº total de reportes de comentarios"># FV</th>
      <th class="r" title="nº total de comentarios reportados"># C</th>
      <th class="r" title="(porcentaje de todos los comentarios del usuario)">% C</th>
    </tr>
    <% @commenters.each do |id, user| %><tr id="<%= user[:username] %>">
      <td>
        <%= link_to user[:username], user_path(user[:username]) %>
        <small>(<%= link_to 'hilos', user_threads_path(user[:username]) %>)</small>
      </td>
      <td class="r"><%= '%.1f' % user[:sigma] %></td>
      <td class="r"><%= '%.1f' % user[:average_flags] %></td>
      <td class="r"><%= user[:n_flags] %></td>
      <td class="r"><%= user[:n_comments] %></td>
      <td class="r"><%= user[:percent_flagged].round %>%</td>
    </tr><% end %>
    <tr>
      <td title="Media de los comentaristas, incluidos los más reportados de arriba">
        Media de <%= @agg[:n_commenters] %> comentaristas
      </td>
      <td class="r" title="0 por definición; () es la desviación estándar">
        (&sigma; = <%= '%.1f' % @agg[:stddev] %>)
      </td>
      <td class="r"><%= '%.1f' % @agg[:avg] %></td>
      <td class="r"><%= (@agg[:avg] * @agg[:n_comments]).round %></td>
      <td class="r"><%= '%.1f' % @agg[:n_comments] %></td>
    </tr>
  </table>

<% else %>
  <div class="nominal">🦞</div>
<% end %>
