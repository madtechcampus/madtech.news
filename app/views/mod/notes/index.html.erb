<%= render partial: 'mod/subnav', locals: { periods: @periods } %>

<%= form_with url: mod_notes_path, method: :get do |f| %>
  <div class="boxline">
    <label class="normal" for="username">Nombre de usuario</label>
    <input type="text" name="username" value="<%= @username %>" autocapitalize="off">
    <%= f.submit 'Filtrar' %>
  </div>
<% end %>

<%= render partial: 'table', locals: {
  mod_notes: @notes
} %>
