<%# locals: (periods:) -%>
<% content_for :subnav do %>
  <style> header#subnav a { margin: 0 0.25rem 0 0; } </style>
  <%= link_to_different_page 'Actividad', mod_path %>
  Historias reportadas: <% periods.each do |p| %><%= link_to_different_page(p, mod_flagged_stories_path(period: p)) %> <% end %>
  Comentarios reportados: <% periods.each do |p| %><%= link_to_different_page(p, mod_flagged_comments_path(period: p)) %> <% end %>
Comentaristas: <% %w{1m 2m 3m 6m}.each do |p| %><%= link_to_different_page(p, mod_commenters_path(period: p)) %> <% end %>
<% end %>
