<%= form_with model: @hat, url: update_in_place_hat_path(@hat), method: :post do |f| %>
  <div class="labelled_grid">
    <%= f.label :user_id, "Usuario" %>
    <%= styled_user_link @hat.user %>

    <%= f.label :hat, "Distintivo" %>
    <%= f.text_field :hat %>

    <%= f.label :link, "Enlace" %>
    <%= f.text_field :link %>
  </div>

  <div class="row">
    <%= f.submit "Editar en el sitio", formaction: update_in_place_hat_path(@hat) %>
    <%= f.submit "Retirar y crear", formaction: update_by_recreating_hat_path(@hat) %>
  </div>
<% end %>
