<p>
  Si has olvidado tu contraseña, introduce abajo tu correo o tu usuario
  y te enviaremos las instrucciones por correo.
</p>

<%= form_with url: reset_password_path do |f| %>
  <div class="labelled_grid">
    <%= f.label :email, "Correo o usuario" %>
    <%= f.text_field :email, size: 40, autofocus: :autofocus, inputmode: :email, autocapitalize: :off %>
  </div>

  <%= f.submit "Restablecer contraseña" %>
<% end %>
