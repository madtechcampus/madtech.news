<link rel="prefetch" href="<%= path_to_javascript 'application' %>" as="script" />

<% if Rails.application.read_only? %>
  <p>
  El sitio está actualmente en modo de solo lectura por mantenimiento.
  </p>
<% else %>
  <%= form_with url: login_path do |form| %>
    <div class="labelled_grid">
      <%= form.label :email, "Correo o usuario" %>
      <%= form.text_field :email, size: 40, inputmode: :email, autofocus: :autofocus, autocapitalize: :off %>

      <%= form.label :password, "Contraseña" %>
      <%= form.password_field :password, :size => 30 %>
    </div>
    <%= form.submit "Iniciar sesión" %>

    <p>
      ¿Has olvidado tu contraseña o desactivado tu cuenta?
      <%= link_to "Restablece tu contraseña", forgot_password_path %>.
    </p>

    <% if Rails.application.open_signups? %>
      <p>
        ¿Todavía no tienes cuenta? <a href="/invitations/open">Regístrate aquí</a>.
      </p>
      <% elsif Rails.application.allow_invitation_requests? %>
      <p>
        ¿Todavía no tienes cuenta? <a href="/invitations/request">Solicita una invitación</a>.
      </p>
    <% else %>
      <p>
      ¿Todavía no tienes cuenta?
      Lee sobre <a href="/about#invitations">cómo funcionan las invitaciones</a> y comprueba si conoces a
      <%= link_to 'un usuario actual', users_tree_path %> del sitio.
      La <a href="/chat">sala de chat</a> no requiere invitación.
      </p>
    <% end %>

    <% if @referer.present? %>
      <%= form.hidden_field :referer, value: @referer %>
    <% end %>
  <% end %>
<% end %>
