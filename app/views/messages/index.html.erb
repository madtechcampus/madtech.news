<%= render partial: 'subnav' %>

<% if @messages.any? %>
  <%= form_with url: batch_delete_messages_path do |f| %>
    <table class="data zebra with_select_all" width="100%" cellspacing=0>
    <tr>
      <th width="3%"></th>
      <th width="15%"><%= @direction == :in ? "De" : "Para" %></th>
      <th width="17%"><%= @direction == :in ? "Recibido" : "Enviado" %></th>
      <th width="60%">Asunto</th>
    </tr>
    <% @messages.each do |message| %>
      <tr class="<%= message.notification&.read_at ? "" : "bold" %>">
        <td><%= check_box_tag "delete_#{message.short_id}" %></td>
        <td>
          <div style="white-space:nowrap;">
            <% if @direction == :in %>
              <% if message.author %>
                <%= styled_user_link message.author %> <%= you_invited you: @user, user: message.author %>
              <% else %>
                <%= message.author_username %>
              <% end %>
              <%= styled_hat(message.hat) if message.hat %>
            <% else %>
              <%= styled_user_link message.recipient %> <%= you_invited you: @user, user: message.recipient %>
            <% end %>
          </div>
        </td>
        <td><%= how_long_ago_label(message.created_at) %></td>
        <td><%= link_to message.subject, message_path(message) %></td>
      </tr>
    <% end %>
    </table>
    <%= f.submit "Eliminar seleccionados" %>
  <% end %>
<% else %>
  <p>
  No tienes ningún mensaje privado<%= @direction == :in ? "" : " enviado" %>.
  </p>
<% end %>

<p>
  Redactar mensaje
</p>

<%= render partial: 'form', locals: { new_message: @new_message, replying: false } %>
