# MadTech News — production environment.
# Copy to .env and fill in. NEVER commit .env (it's gitignored).
#
#   cp .env.sample .env
#
# Generate SECRET_KEY_BASE with:  docker run --rm madtech-news:latest bin/rails secret
#   (or, before first build, any: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)')

# ---- Site identity -------------------------------------------------------
SITE_NAME=MadTech News
SITE_DOMAIN=madtech.news
SITE_DESCRIPTION=Agregador de enlaces y discusión de la comunidad Mad Tech Campus.
DEFAULT_LOCALE=es
TIME_ZONE=Madrid

# ACME / Let's Encrypt contact email used by Caddy.
TLS_EMAIL=admin@madtech.news

# ---- Rails ---------------------------------------------------------------
RAILS_ENV=production
SECRET_KEY_BASE=CHANGE_ME_run_bin_rails_secret
RAILS_MAX_THREADS=10
# PUMA_WORKERS defaults to CPU count; uncomment to pin it.
# PUMA_WORKERS=2

# ---- Database (MariaDB) --------------------------------------------------
DATABASE_NAME=madtech
DATABASE_USER=madtech
DATABASE_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# ---- Email (SMTP) --------------------------------------------------------
# Required for invitations and password resets. Leave SMTP_ADDRESS blank to
# disable real delivery (mail is only logged). Use a transactional provider
# (Mailgun, Postmark, Brevo, Amazon SES, ...) or your own SMTP relay.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS=true
# SMTP_DOMAIN defaults to SITE_DOMAIN.
# SMTP_DOMAIN=madtech.news

# ---- Signups -------------------------------------------------------------
# Lobsters is invite-only by default. Set to "true" temporarily to open public
# signups (see the warning in config/application.rb).
OPEN_SIGNUPS=false
